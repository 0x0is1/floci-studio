{
  "name": "floci-studio-desktop",
  "productName": "Floci Studio",
  "version": "1.0.0",
  "description": "AWS Visual Cloud Infrastructure Playground",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build:splash": "bun run --cwd splash build",
    "build:electron": "bun tsc && bun tsc-alias",
    "build": "bun run build:splash && bun run build:electron",
    "start": "electron .",
    "test": "bun test tests/checkers.test.ts",
    "dist": "electron-builder --win --dir",
    "dist:exe": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.floci.studio",
    "productName": "Floci Studio",
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "splash/out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir",
        "portable"
      ],
      "icon": "assets/icon.ico"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.13.1",
    "electron": "^34.0.0",
    "electron-builder": "^26.18.0",
    "tsc-alias": "^1.9.9",
    "typescript": "^5.7.3"
  }
}
